{
  "nodes": [
    {
      "id": "file:app/config.py",
      "type": "file",
      "name": "config.py",
      "filePath": "app/config.py",
      "summary": "Defines the Flask application's configuration system: a BaseConfig with environment-driven settings (Elasticsearch, MongoDB, MySQL, JWT, rate limiting, Ollama, Vexyl STT/TTS, GPU server, document summary tuning) plus Development/Testing/Production subclasses and a ConfigFactory to select and validate the active config.",
      "tags": ["config", "entry-point", "environment-variables", "factory", "validation"],
      "complexity": "moderate",
      "languageNotes": "Uses os.getenv with defaults plus a static validate() method overridden per-environment (e.g., TestingConfig skips validation) — a simple config-factory pattern common in Flask apps."
    },
    {
      "id": "class:app/config.py:BaseConfig",
      "type": "class",
      "name": "BaseConfig",
      "filePath": "app/config.py",
      "lineRange": [14, 78],
      "summary": "Base configuration class holding shared settings for secret keys, Elasticsearch/MongoDB/MySQL connections, JWT, rate limiting, Ollama models, Vexyl TTS/STT URLs, GPU server parameters, and document summary tuning values, plus a validate() check for required environment variables.",
      "tags": ["config", "validation", "environment-variables"],
      "complexity": "moderate"
    },
    {
      "id": "class:app/config.py:DevelopmentConfig",
      "type": "class",
      "name": "DevelopmentConfig",
      "filePath": "app/config.py",
      "lineRange": [80, 83],
      "summary": "Development environment configuration that enables DEBUG mode, inheriting all other settings from BaseConfig.",
      "tags": ["config", "environment-variables"],
      "complexity": "simple"
    },
    {
      "id": "class:app/config.py:TestingConfig",
      "type": "class",
      "name": "TestingConfig",
      "filePath": "app/config.py",
      "lineRange": [85, 98],
      "summary": "Testing environment configuration that enables DEBUG/TESTING flags, points MONGO_URL at a local test database, and overrides validate() to skip required-variable checks.",
      "tags": ["config", "test", "validation"],
      "complexity": "simple"
    },
    {
      "id": "class:app/config.py:ProductionConfig",
      "type": "class",
      "name": "ProductionConfig",
      "filePath": "app/config.py",
      "lineRange": [100, 110],
      "summary": "Production environment configuration enforcing a stronger SECRET_KEY requirement and stricter rate limiting defaults.",
      "tags": ["config", "validation", "environment-variables"],
      "complexity": "simple"
    },
    {
      "id": "class:app/config.py:ConfigFactory",
      "type": "class",
      "name": "ConfigFactory",
      "filePath": "app/config.py",
      "lineRange": [112, 145],
      "summary": "Factory class that maps a config name string (development/testing/production/default) to the corresponding config class, running validate() except in testing mode.",
      "tags": ["factory", "config", "validation"],
      "complexity": "simple"
    },
    {
      "id": "file:elastic/client.py",
      "type": "file",
      "name": "client.py",
      "filePath": "elastic/client.py",
      "summary": "Provides a singleton ElasticClient wrapper that lazily initializes and exposes a shared Elasticsearch connection, with ping and index_exists helper methods.",
      "tags": ["singleton", "service", "database", "elasticsearch"],
      "complexity": "simple",
      "languageNotes": "Implements the singleton pattern via __new__ to ensure a single shared Elasticsearch client instance across the application."
    },
    {
      "id": "class:elastic/client.py:ElasticClient",
      "type": "class",
      "name": "ElasticClient",
      "filePath": "elastic/client.py",
      "lineRange": [7, 34],
      "summary": "Singleton wrapper around the Elasticsearch Python client; initializes the connection from Config.ES_BASE_URL on first use and exposes ping() and index_exists() helpers.",
      "tags": ["singleton", "elasticsearch", "service"],
      "complexity": "simple"
    },
    {
      "id": "file:elastic/document_manager.py",
      "type": "file",
      "name": "document_manager.py",
      "filePath": "elastic/document_manager.py",
      "summary": "Manages storing documents into Elasticsearch with embeddings, including Unicode/Hindi-aware preprocessing before indexing via ElasticsearchStore; update/delete operations are stubbed as TODOs.",
      "tags": ["service", "database", "elasticsearch", "data-pipeline"],
      "complexity": "moderate",
      "languageNotes": "Normalizes text with unicodedata.normalize('NFC', ...) to ensure consistent multilingual (Hindi) Unicode handling before embedding and indexing."
    },
    {
      "id": "class:elastic/document_manager.py:ElasticDocumentManager",
      "type": "class",
      "name": "ElasticDocumentManager",
      "filePath": "elastic/document_manager.py",
      "lineRange": [12, 83],
      "summary": "Coordinates document ingestion into an Elasticsearch index: preprocesses documents for Unicode normalization, ensures the index exists, embeds and stores documents via ElasticsearchStore, and refreshes the index. update_documents and delete_documents are unimplemented placeholders.",
      "tags": ["service", "elasticsearch", "data-pipeline"],
      "complexity": "moderate"
    },
    {
      "id": "file:elastic/index_manager.py",
      "type": "file",
      "name": "index_manager.py",
      "filePath": "elastic/index_manager.py",
      "summary": "Manages Elasticsearch index lifecycle (create, delete, refresh, existence checks) using a custom mapping with dense_vector embeddings and Hindi/multilingual text analyzers.",
      "tags": ["service", "database", "elasticsearch", "schema-definition"],
      "complexity": "moderate",
      "languageNotes": "Defines a custom Elasticsearch mapping with a hindi_analyzer and multilingual_analyzer, plus a dense_vector field (1024 dims) for hybrid keyword+vector search support."
    },
    {
      "id": "class:elastic/index_manager.py:ElasticIndexManager",
      "type": "class",
      "name": "ElasticIndexManager",
      "filePath": "elastic/index_manager.py",
      "lineRange": [5, 112],
      "summary": "Manages Elasticsearch index lifecycle operations — creating indices with a multilingual/vector-aware mapping (with retry-based readiness checks), deleting, refreshing, and checking existence.",
      "tags": ["elasticsearch", "service", "schema-definition"],
      "complexity": "moderate"
    },
    {
      "id": "file:elastic/retriever.py",
      "type": "file",
      "name": "retriever.py",
      "filePath": "elastic/retriever.py",
      "summary": "Implements hybrid (keyword + vector) document retrieval over Elasticsearch using an EnsembleRetriever, with LLM-based query enrichment that rewrites queries using chat context, plus a helper to fetch all chunks belonging to a table for full-table retrieval.",
      "tags": ["service", "elasticsearch", "data-pipeline", "validation"],
      "complexity": "complex",
      "languageNotes": "Combines a custom ElasticsearchRetriever (keyword search with Hindi-aware fields) and an ElasticsearchStore vector retriever into a weighted EnsembleRetriever (0.4/0.6), and uses an LLM call to enrich/rewrite the query before keyword search."
    },
    {
      "id": "class:elastic/retriever.py:ElasticRetriever",
      "type": "class",
      "name": "ElasticRetriever",
      "filePath": "elastic/retriever.py",
      "lineRange": [17, 188],
      "summary": "Performs hybrid keyword+vector search against an Elasticsearch index by combining a custom keyword retriever and a vector store retriever into an EnsembleRetriever; enriches user queries via an LLM call (optionally using chat context) before keyword search, and supports fetching full table chunks beyond the top-k limit.",
      "tags": ["elasticsearch", "service", "data-pipeline"],
      "complexity": "complex"
    }
  ],
