      "type": "file",
      "name": "response_generator_service.py",
      "filePath": "app/services/response_generator_service.py",
      "summary": "Generates the final natural-language responses for every query mode (general chat, document, data, hybrid, document-aware chat) by building mode-specific prompts, invoking the LLM, parsing structured JSON-like output, and translating results to the user's requested language.",
      "tags": ["service", "response-generation", "prompt-engineering", "llm"],
      "complexity": "complex",
      "languageNotes": "Heavy use of regex-based structured-response extraction and JSON parsing fallbacks to robustly handle LLM output that may not strictly follow the requested format, plus an integration point with the translation utility for multi-language output."
    },
    {
      "id": "class:app/services/response_generator_service.py:ResponseGeneratorService",
