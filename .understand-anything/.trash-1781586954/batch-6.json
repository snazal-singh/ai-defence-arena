    {
      "id": "file:app/services/query_agent_service.py",
      "type": "file",
      "name": "query_agent_service.py",
      "filePath": "app/services/query_agent_service.py",
      "summary": "Top-level orchestrator for the query pipeline: combines intent classification, chat context retrieval, document/data/hybrid context lookup, optional creative reasoning mode, and response generation into a single process_query entry point.",
      "tags": ["service", "orchestrator", "entry-point", "query-processing"],
      "complexity": "complex",
      "languageNotes": "Acts as a facade composing five other services (intent, context provider, response generator, chat history, chat context, and an optional creative reasoning service) and dispatches to mode-specific handlers (document, data, hybrid, summary, general chat)."
    },
    {
      "id": "class:app/services/query_agent_service.py:QueryAgentService",
      "type": "class",
      "name": "QueryAgentService",
      "filePath": "app/services/query_agent_service.py",
      "lineRange": [35, 700],
      "summary": "Main query-processing facade that wires together intent classification, context retrieval, chat history, and response generation, exposing process_query as the primary API used by callers to answer user questions against documents and structured data.",
      "tags": ["orchestrator", "service", "query-processing", "facade"],
      "complexity": "complex"
    },
