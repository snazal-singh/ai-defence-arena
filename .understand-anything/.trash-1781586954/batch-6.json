      "type": "file",
      "name": "translation.py",
      "filePath": "utils/translation.py",
      "summary": "Translation utility that delegates to a remote IndicTrans2 inference server, providing translate_to_indic and translate_to_english helpers for converting text between English and 23 Indic languages using FLORES-200 language codes.",
      "tags": ["utility", "translation", "multi-language", "http-client"],
      "complexity": "moderate",
      "languageNotes": "Configuration (server URL, API key, timeout) is read once at import time from environment variables; sentence splitting is used to keep translation requests within manageable chunk sizes for the remote service."
    },
