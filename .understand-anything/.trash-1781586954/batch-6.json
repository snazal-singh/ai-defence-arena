    {
      "id": "file:app/services/chat_context_service.py",
      "type": "file",
      "name": "chat_context_service.py",
      "filePath": "app/services/chat_context_service.py",
      "summary": "Detects whether a follow-up query needs prior conversation context (via regex patterns plus LLM fallback) and extracts the relevant slice of chat history to feed into downstream prompts.",
      "tags": ["service", "context-management", "nlp", "pattern-matching"],
      "complexity": "complex",
      "languageNotes": "Combines fast regex-based heuristics with an LLM-based fallback, merging both signals via a confidence-weighted combination step before extracting context using one of several specialized strategies (recent, reference, clarification, continuation, adaptive)."
    },
    {
      "id": "class:app/services/chat_context_service.py:ChatContextService",
      "type": "class",
      "name": "ChatContextService",
      "filePath": "app/services/chat_context_service.py",
      "lineRange": [17, 426],
      "summary": "Core service that detects context-dependency in user queries and extracts the most relevant chat history segment using regex pattern matching combined with an LLM-based classifier.",
      "tags": ["service", "context-detection", "chat-history", "nlp"],
      "complexity": "complex"
    },
    {
      "id": "function:app/services/chat_context_service.py:get_chat_context_service",
