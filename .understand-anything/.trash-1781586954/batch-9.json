    {
      "id": "file:load_test.py",
      "type": "file",
      "name": "load_test.py",
      "filePath": "load_test.py",
      "summary": "Standalone concurrent load-testing script that simulates multiple users hitting the /ask endpoint, measuring response time, time-to-first-byte, and answer length, then reports aggregate statistics and optionally exports results to CSV.",
      "tags": ["script", "load-testing", "cli-tool", "performance"],
      "complexity": "complex",
      "languageNotes": "Uses ThreadPoolExecutor for concurrency simulation and dataclasses for structured per-request results; runnable via argparse CLI with configurable rounds, user counts, and target URL."
    },
    {
      "id": "class:load_test.py:RequestResult",
      "type": "class",
      "name": "RequestResult",
      "filePath": "load_test.py",
      "lineRange": [137, 148],
      "summary": "Dataclass capturing the outcome of a single simulated /ask request, including timing, status code, answer length/preview, and success/error state.",
      "tags": ["data-model", "load-testing"],
      "complexity": "simple"
    },
    {
      "id": "function:load_test.py:send_ask_request",
      "type": "function",
      "name": "send_ask_request",
      "filePath": "load_test.py",
      "lineRange": [155, 239],
      "summary": "Sends a single streaming POST request to the /ask endpoint for a simulated user/question, measuring total time and time-to-first-byte, and returns a RequestResult.",
      "tags": ["load-testing", "http-client", "streaming"],
      "complexity": "complex"
    },
    {
