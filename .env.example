ES_CLOUD_ID=My_deployment:key
ES_API_KEY=update_your_key
GEMINI_API_KEY=update_your_key
GEMINI_API_KEY_PREV=update_your_key
MISTRAL_OCR_API_KEY=update_your_key
OPENAI_API_KEY=update_your_key
MONGO_URL=mongodb://localhost:27017
MYSQL_HOST=localhost
MYSQL_USERNAME=user
MYSQL_PASSWORD=pass
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=pass
BHASHINI_INFERENCE_KEY=update_your_key
ELEVENLABS_API_KEY=update_your_key
ES_BASE_URL=http://localhost:9200
NEO4J_URI=neo4j://localhost:7687
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_LLM_MODEL=qwen2.5:7b

# Set to true to allow attaching external Mongo servers on localhost/private
# addresses (dev/self-hosted only); defaults to false (public hosts only).
ALLOW_LOCAL_MONGO=False


# GPU Server configuration
GPU_SERVER_BASE_URL=https://llm.inference.server
GPU_SERVER_API_KEY=update_your_key
GPU_SERVER_MODEL=llama3.1:8b
GPU_SERVER_DEFAULT_MAX_TOKENS=1000
GPU_SERVER_VERIFY_SSL=False
TRANSLATION_SERVER_URL=https://translation.inference.server

# Vexyl STT/TTS servers (ai4bharat Indic models)
VEXYL_TTS_URL=ws://127.0.0.1:8092
VEXYL_STT_URL=ws://127.0.0.1:8091
# AI Red Team Arena (same FastAPI server, /arena)
# Export these variables or launch uvicorn with --env-file .env.
DEMO_MODE=false
REDTEAM_DATABASE=redteam/data/arena.sqlite
# Generate a strong random token; keep it exclusively on administrative systems.
REDTEAM_ADMIN_TOKEN=
REDTEAM_MODEL_LABEL=Application model
# Optional trusted OpenAI-compatible chat completions classifier.
# Enabling this sends bounded user prompt text to this configured service.
REDTEAM_CLASSIFIER_URL=
REDTEAM_CLASSIFIER_KEY=
REDTEAM_CLASSIFIER_MODEL=
# Optional dedicated NON-SECRET test canary (at least 16 chars). Empty disables it.
REDTEAM_TEST_CANARY=
REDTEAM_SCORING={"BLOCKED":5,"DEFENDED":10,"UNKNOWN":2,"PARTIAL":50,"SUCCESSFUL":100,"sophisticated":10,"novel":5,"hourly_cap":300}
